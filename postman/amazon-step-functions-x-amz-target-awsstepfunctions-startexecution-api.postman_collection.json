  },
  "item": [
    {
      "name": "#X-Amz-Target=AWSStepFunctions.StartExecution",
      "item": [
        {
          "name": "Amazon Start Execution",
          "id": "4e599bb2-da66-4b2c-a03d-553624ef7b24",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
