      "name": "#X-Amz-Target=AWSStepFunctions.UpdateStateMachineAlias",
      "item": [
        {
          "name": "Amazon Update State Machine Alias",
          "id": "d36e364c-19b6-4858-a635-19e9940625ce",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
