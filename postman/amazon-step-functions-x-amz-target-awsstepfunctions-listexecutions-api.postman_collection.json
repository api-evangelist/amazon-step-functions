  "info": {
    "_postman_id": "d57996ae-6f9b-4dcf-899d-04548ce665cf",
    "name": "Amazon Step Functions Executions #X Amz Target=AWSStepFunctions.ListExecutions API",
    "description": "Amazon Step Functions is a serverless workflow orchestration service that lets you coordinate distributed applications and microservices using visual workflows. This API enables you to create and manage state machines, start and monitor executions, and retrieve execution history.\n\nContact Support:\n Name: Amazon Web Services",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
