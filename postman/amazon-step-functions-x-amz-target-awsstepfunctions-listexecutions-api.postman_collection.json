              "raw": "{\n  \"stateMachineArn\": \"<string>\",\n  \"statusFilter\": \"TIMED_OUT\",\n  \"maxResults\": \"<integer>\",\n  \"nextToken\": \"<string>\",\n  \"mapRunArn\": \"<string>\"\n}",
