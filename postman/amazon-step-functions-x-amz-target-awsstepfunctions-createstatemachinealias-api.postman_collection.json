      "name": "#X-Amz-Target=AWSStepFunctions.CreateStateMachineAlias",
      "item": [
        {
          "name": "Amazon Create State Machine Alias",
          "id": "f5d13058-adb6-4f18-8ecc-a54f48294e79",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
