      "name": "#X-Amz-Target=AWSStepFunctions.PublishStateMachineVersion",
      "item": [
        {
          "name": "Amazon Publish State Machine Version",
          "id": "345c5876-44e8-4586-afb7-034e7e6e4bc3",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
