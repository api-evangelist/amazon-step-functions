            "body": {
              "mode": "raw",
              "raw": "{\n  \"stateMachineArn\": \"<string>\",\n  \"revisionId\": \"<string>\",\n  \"description\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
