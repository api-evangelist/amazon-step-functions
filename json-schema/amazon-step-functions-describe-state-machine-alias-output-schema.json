    "creationDate": {
      "allOf": [
        {
          "$ref": "#/components/schemas/Timestamp"
        },
        {
          "description": "The date the state machine alias was created."
        }
      ]
    },
    "updateDate": {
      "allOf": [
        {
          "$ref": "#/components/schemas/Timestamp"
